
pipeline {

    agent any

    // Environment variables
    environment {
        BASE_URL = 'https://opensource-demo.orangehrmlive.com/'
        BROWSER = 'chromium'
    }

    // Pipeline settings
    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(
            numToKeepStr: '10'
        ))
        skipDefaultCheckout(true)
    }

    stages {

        // 1. Checkout code from GitHub
        stage('Checkout') {
            steps {
                echo 'Downloading project from GitHub'
                checkout scm
            }
        }

        // 2. Check Node and npm versions
        stage('Check Environment') {
            steps {
                bat 'node --version'
                bat 'npm --version'
            }
        }

        // 3. Install dependencies
        stage('Install Dependencies') {
            steps {
                bat 'npm ci'
            }
        }

        // 4. Install Playwright browser
        stage('Install Playwright Browsers') {
            steps {
                bat 'npx playwright install chromium'
            }
        }

        // 5. Execute automation tests
        stage('Execute Cucumber Tests') {
            steps {
                bat 'npm test'
            }
        }

    }

    // Actions after pipeline execution
    post {

        always {

            // Archive test artifacts
            archiveArtifacts(
                artifacts: 'reports/**/*,screenshots/**/*,videos/**/*,allure-results/**/*',
                allowEmptyArchive: true
            )

            // Generate Allure report
            allure(
                results: [[path: 'allure-results']]
            )
        }

        success {
            echo 'Automation execution PASSED'

            emailext(
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                Hello Team,

                Playwright automation execution completed successfully.

                Job: ${env.JOB_NAME}
                Build: ${env.BUILD_NUMBER}
                Status: SUCCESS

                Check the Jenkins build:
                ${env.BUILD_URL}
                """,
                to: 'your-email@example.com'
            )
        }

        failure {
            echo 'Automation execution FAILED'

            emailext(
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                Hello Team,

                Playwright automation execution failed.

                Job: ${env.JOB_NAME}
                Build: ${env.BUILD_NUMBER}
                Status: FAILURE

                Please check the Jenkins console output:
                ${env.BUILD_URL}
                """,
                to: 'your-email@example.com'
            )
        }
    }
}
